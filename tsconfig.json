{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@audio/*": ["src/audio/*"],
      "@input/*": ["src/input/*"],
      "@render/*": ["src/render/*"],
      "@app/*": ["src/app/*"],
      "@ui/*": ["src/ui/*"]
    }
  },
  "include": ["src", "tests", "vite.config.ts", "vite.videoStatic.ts", "vitest.config.ts"]
}
